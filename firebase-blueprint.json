{
  "entities": {
    "users": {
      "title": "User",
      "description": "Represents a user account in RUDAAI platform",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique user identifier matching Firebase Auth UID"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "User email address"
        },
        "displayName": {
          "type": "string",
          "maxLength": 100,
          "description": "User display name"
        },
        "photoURL": {
          "type": "string",
          "maxLength": 500,
          "description": "User avatar photo URL"
        },
        "role": {
          "type": "string",
          "enum": ["user", "developer", "admin", "super_admin"],
          "description": "Account role in RUDAAI platform"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Account creation timestamp"
        }
      },
      "required": ["id", "email", "createdAt"]
    },
    "admins": {
      "title": "Admin",
      "description": "Represents an authorized administrative record in RUDAAI",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique admin identifier matching UID"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Administrative email address"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Admin authorization timestamp"
        }
      },
      "required": ["id", "email", "createdAt"]
    },
    "products": {
      "title": "Product",
      "description": "AI Employee product listed in marketplace",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "maxLength": 100 },
        "role": { "type": "string", "maxLength": 100 },
        "industryId": { "type": "string" },
        "monthlyPrice": { "type": "number" },
        "taskPrice": { "type": "number" },
        "status": { "type": "string", "enum": ["published", "pending", "rejected", "archived"] },
        "vendorId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "industryId", "monthlyPrice", "status"]
    },
    "orders": {
      "title": "Order",
      "description": "Purchase transaction for an AI Employee or task quota",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "amount": { "type": "number" },
        "currency": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "paid", "refunded", "failed"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "amount", "status", "createdAt"]
    },
    "tasks": {
      "title": "Task",
      "description": "AI task execution record and deliverables",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "employeeId": { "type": "string" },
        "title": { "type": "string", "maxLength": 200 },
        "status": { "type": "string", "enum": ["queued", "running", "completed", "failed"] },
        "output": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "title", "status", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/users"
      },
      "description": "User profile collection"
    },
    "/admins/{adminId}": {
      "schema": {
        "$ref": "#/entities/admins"
      },
      "description": "Trusted administrator access control collection"
    },
    "/products/{productId}": {
      "schema": {
        "$ref": "#/entities/products"
      },
      "description": "Public AI employee marketplace catalog"
    },
    "/orders/{orderId}": {
      "schema": {
        "$ref": "#/entities/orders"
      },
      "description": "Commercial orders and transactions"
    },
    "/tasks/{taskId}": {
      "schema": {
        "$ref": "#/entities/tasks"
      },
      "description": "User autonomous task runs and deliverable records"
    }
  }
}
